<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TikTok-style full-screen application theme -->
    <style name="Theme.DorflixNative" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Full-screen immersive mode -->
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- <item name="android:windowLightNavigationBar">false</item> -->

        <!-- Typography -->
        <item name="textAppearanceHeadline1">@style/TextAppearance.Dorflix.Headline1</item>
        <item name="textAppearanceHeadline2">@style/TextAppearance.Dorflix.Headline2</item>
        <item name="textAppearanceHeadline3">@style/TextAppearance.Dorflix.Headline3</item>
        <item name="textAppearanceHeadline4">@style/TextAppearance.Dorflix.Headline4</item>
        <item name="textAppearanceHeadline5">@style/TextAppearance.Dorflix.Headline5</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.Dorflix.Headline6</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.Dorflix.Subtitle1</item>
        <item name="textAppearanceSubtitle2">@style/TextAppearance.Dorflix.Subtitle2</item>
        <item name="textAppearanceBody1">@style/TextAppearance.Dorflix.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.Dorflix.Body2</item>
        <item name="textAppearanceCaption">@style/TextAppearance.Dorflix.Caption</item>
        <item name="textAppearanceButton">@style/TextAppearance.Dorflix.Button</item>
        <item name="textAppearanceOverline">@style/TextAppearance.Dorflix.Overline</item>
    </style>
    
    <!-- Light theme -->
    <style name="Theme.DorflixNative.Light" parent="Theme.DorflixNative">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/background</item>
    </style>
    
    <!-- Dark theme -->
    <style name="Theme.DorflixNative.Dark" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gray_800</item>
        <item name="colorPrimaryVariant">@color/gray_900</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/gray_900</item>
        <item name="android:navigationBarColor">@color/gray_900</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    
    <!-- Typography Styles -->
    <style name="TextAppearance.Dorflix.Headline1" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    
    <style name="TextAppearance.Dorflix.Headline2" parent="TextAppearance.MaterialComponents.Headline2">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    
    <style name="TextAppearance.Dorflix.Headline3" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    
    <style name="TextAppearance.Dorflix.Headline4" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    
    <style name="TextAppearance.Dorflix.Headline5" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    
    <style name="TextAppearance.Dorflix.Headline6" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    
    <style name="TextAppearance.Dorflix.Subtitle1" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    
    <style name="TextAppearance.Dorflix.Subtitle2" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    
    <style name="TextAppearance.Dorflix.Body1" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    
    <style name="TextAppearance.Dorflix.Body2" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    
    <style name="TextAppearance.Dorflix.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    
    <style name="TextAppearance.Dorflix.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
    </style>
    
    <style name="TextAppearance.Dorflix.Overline" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    
    <!-- Card Styles -->
    <style name="Widget.Dorflix.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
    </style>
    
    <!-- Button Styles -->
    <style name="Widget.Dorflix.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">4dp</item>
        <item name="textAllCaps">false</item>
    </style>
    
    <style name="Widget.Dorflix.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">4dp</item>
        <item name="textAllCaps">false</item>
    </style>
    
    <!-- Bottom Navigation Styles -->
    <style name="Widget.Dorflix.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_colors</item>
        <item name="itemTextColor">@color/bottom_nav_colors</item>
        <item name="elevation">8dp</item>
    </style>
</resources>
